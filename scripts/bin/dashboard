#!/usr/bin/env bash
set -euo pipefail

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell"
runtime_dir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
PIDFILE="$runtime_dir/mihao-dashboard.pid"
LOGFILE="$runtime_dir/mihao-dashboard.log"

if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
  kill "$(cat "$PIDFILE")" 2>/dev/null || true
  rm -f "$PIDFILE"
else
  qs --path "$config_dir/dashboard.qml" >"$LOGFILE" 2>&1 &
  echo $! > "$PIDFILE"
fi
