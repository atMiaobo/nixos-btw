#!/usr/bin/env python3
"""Compatibility entry point for palette-only legacy preset application."""
from pathlib import Path
import sys
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from theming.engine import Engine
from theming.model import ThemeError

if len(sys.argv) != 2:
    print('Usage: theme-apply PRESET_ID_OR_TOML', file=sys.stderr)
    raise SystemExit(2)
try:
    engine = Engine()
    supplied = Path(sys.argv[1]).expanduser()
    path = supplied.resolve() if supplied.is_file() else engine.config / 'themes/presets' / (sys.argv[1].removesuffix('.toml') + '.toml')
    with engine.locked():
        state = engine.state(False)
        marker = engine.cache.parent / 'mihao/current-wallpaper'
        if state and state['selection']['path']:
            entry = engine.find(state['selection']['path'], str(path))
        elif marker.is_file():
            entry = engine.find(marker.read_text().strip(), str(path))
        else:
            entry = dict(name=path.stem, path='', theme=str(path), explicit=True)
        failures = engine.apply(entry, wallpaper=False)
        for failure in failures:
            print('theme-apply: ' + failure, file=sys.stderr)
        raise SystemExit(3 if failures else 0)
except (OSError, ThemeError) as exc:
    print(f'theme-apply: {exc}', file=sys.stderr)
    raise SystemExit(1)
