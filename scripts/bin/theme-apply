#!/usr/bin/env python3

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path
from typing import NoReturn


HOME = Path.home()

PRESET_DIR = HOME / ".config/themes/presets"
CACHE_DIR = HOME / ".cache/theme"
GENERATED_DIR = CACHE_DIR / "generated"

HEX_PATTERN = re.compile(r"^#[0-9a-fA-F]{6}$")

REQUIRED_ROLES = {
    "background",
    "background_alt",
    "background_deep",
    "surface",
    "surface_alt",
    "surface_high",
    "foreground",
    "foreground_alt",
    "muted",
    "disabled",
    "accent",
    "accent_alt",
    "on_accent",
    "selection",
    "selection_text",
    "hover",
    "pressed",
    "focus",
    "border",
    "border_inactive",
    "shadow",
    "success",
    "warning",
    "error",
    "critical",
    "info",
    "link",
    "link_visited",
    "match",
    "highlight",
}


def die(message: str) -> NoReturn:
    print(f"theme-apply: {message}", file=sys.stderr)
    raise SystemExit(1)


def atomic_write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)

    fd, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.",
        dir=path.parent,
        text=True,
    )

    try:
        with os.fdopen(fd, "w", encoding="utf-8") as temporary_file:
            temporary_file.write(content)

        os.chmod(temporary_name, 0o644)
        os.replace(temporary_name, path)
    except Exception:
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass
        raise


def resolve_color(value: str, palette: dict[str, str], role: str) -> str:
    if value in palette:
        value = palette[value]

    if not HEX_PATTERN.fullmatch(value):
        die(
            f"role '{role}' references invalid color '{value}'. "
            "Expected a palette name or #RRGGBB."
        )

    return value.lower()


def rgba(color: str, alpha: str = "ff") -> str:
    """Convert #RRGGBB to Fuzzel's RRGGBBAA format."""
    return color.removeprefix("#") + alpha


def run_optional(command: list[str]) -> None:
    try:
        subprocess.run(
            command,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        pass


def main() -> None:
    if len(sys.argv) != 2:
        die("usage: theme-apply THEME_ID")

    theme_id = sys.argv[1]
    preset_path = PRESET_DIR / f"{theme_id}.toml"

    if not preset_path.is_file():
        die(f"preset does not exist: {preset_path}")

    with preset_path.open("rb") as file:
        preset = tomllib.load(file)

    metadata = preset.get("theme")
    palette = preset.get("palette")
    role_references = preset.get("roles")

    if not isinstance(metadata, dict):
        die("preset is missing [theme]")

    if not isinstance(palette, dict):
        die("preset is missing [palette]")

    if not isinstance(role_references, dict):
        die("preset is missing [roles]")

    missing_roles = REQUIRED_ROLES - role_references.keys()

    if missing_roles:
        die("preset is missing roles: " + ", ".join(sorted(missing_roles)))

    resolved = {
        role: resolve_color(value, palette, role)
        for role, value in role_references.items()
    }

    GENERATED_DIR.mkdir(parents=True, exist_ok=True)

    # --------------------------------------------------------
    # Shared JSON for Quickshell and other consumers
    # --------------------------------------------------------

    active_theme = {
        "id": theme_id,
        "name": metadata.get("name", theme_id),
        "variant": metadata.get("variant", "dark"),
        "colors": resolved,
    }

    atomic_write(
        CACHE_DIR / "active.json",
        json.dumps(active_theme, indent=2) + "\n",
    )

    # --------------------------------------------------------
    # Hyprland Lua theme module
    # --------------------------------------------------------

    lua_lines = [
        "-- Generated by theme-apply. Do not edit.",
        "return {",
    ]

    for key, value in sorted(resolved.items()):
        lua_lines.append(f'    {key} = "{value}",')

    lua_lines.append("}")
    lua_lines.append("")

    atomic_write(
        HOME / ".config/hypr/theme.lua",
        "\n".join(lua_lines),
    )

    # --------------------------------------------------------
    # Fuzzel colors
    # --------------------------------------------------------

    fuzzel = f"""# Generated by theme-apply. Do not edit.

[colors]
background={rgba(resolved["background"], "ee")}
text={rgba(resolved["foreground"])}
prompt={rgba(resolved["accent"])}
placeholder={rgba(resolved["muted"])}
input={rgba(resolved["foreground"])}
match={rgba(resolved["match"])}
selection={rgba(resolved["selection"])}
selection-text={rgba(resolved["selection_text"])}
selection-match={rgba(resolved["highlight"])}
counter={rgba(resolved["foreground_alt"])}
border={rgba(resolved["accent"])}
"""

    atomic_write(
        HOME / ".config/fuzzel/colors.ini",
        fuzzel,
    )

    # --------------------------------------------------------
    # Dunst drop-in
    # --------------------------------------------------------

    dunst = f"""# Generated by theme-apply. Do not edit.

[global]
    foreground = "{resolved["foreground"]}"
    background = "{resolved["surface"]}"
    frame_color = "{resolved["accent"]}"
    separator_color = "{resolved["border"]}"

[urgency_low]
    foreground = "{resolved["foreground_alt"]}"
    background = "{resolved["background_alt"]}"
    frame_color = "{resolved["border_inactive"]}"

[urgency_normal]
    foreground = "{resolved["foreground"]}"
    background = "{resolved["surface"]}"
    frame_color = "{resolved["accent"]}"

[urgency_critical]
    foreground = "{resolved["foreground"]}"
    background = "{resolved["surface"]}"
    frame_color = "{resolved["error"]}"
"""

    atomic_write(
        HOME / ".config/dunst/dunstrc.d/99-theme.conf",
        dunst,
    )

    # Remember the active theme separately for shell scripts.
    atomic_write(CACHE_DIR / "current", theme_id + "\n")

    run_optional(["hyprctl", "reload"])
    run_optional(["dunstctl", "reload"])

    print(f"Applied theme: {theme_id}")


if __name__ == "__main__":
    main()

