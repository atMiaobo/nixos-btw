#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}"
STATE_FILE="$STATE_DIR/power-mode.current"

DISPLAY_OUTPUT="${POWER_MODE_OUTPUT:-eDP-1}"
DISPLAY_RES="${POWER_MODE_RES:-2560x1600}"
DISPLAY_SCALE="${POWER_MODE_SCALE:-1.6}"

NORMAL_HZ="${POWER_MODE_NORMAL_HZ:-120}"
MONK_HZ="${POWER_MODE_MONK_HZ:-60}"

notify() {
  local title="$1"
  local body="$2"

  if command -v dunstify >/dev/null 2>&1; then
    dunstify \
      -a power-mode \
      -h string:x-dunst-stack-tag:power-mode \
      "$title" "$body"
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "$title" "$body"
  fi
}

write_sysfs() {
  local path="$1"
  local value="$2"

  [ -e "$path" ] || return 0
  printf '%s\n' "$value" | sudo tee "$path" >/dev/null 2>&1 || true
}

set_profile() {
  local profile="$1"

  if command -v powerprofilesctl >/dev/null 2>&1; then
    powerprofilesctl set "$profile"
  else
    echo "powerprofilesctl not found"
    return 1
  fi
}

set_refresh_rate() {
  local hz="$1"

  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl eval \
      "hl.monitor({ output = \"${DISPLAY_OUTPUT}\", mode = \"${DISPLAY_RES}@${hz}\", position = \"0x0\", scale = ${DISPLAY_SCALE} })" \
      >/dev/null 2>&1 || true
  fi
}

set_wifi_powersave() {
  local mode="$1"

  command -v iw >/dev/null 2>&1 || return 0

  for iface in $(iw dev | awk '$1 == "Interface" {print $2}'); do
    sudo iw dev "$iface" set power_save "$mode" >/dev/null 2>&1 || true
  done
}

set_keyboard_backlight() {
  local value="$1"

  for led in /sys/class/leds/*; do
    [ -e "$led/brightness" ] || continue

    local name
    name="$(basename "$led")"

    case "$name" in
      *kbd*|*keyboard*)
        write_sysfs "$led/brightness" "$value"
        ;;
    esac
  done
}

save_mode() {
  printf '%s\n' "$1" > "$STATE_FILE"
}

current_mode() {
  cat "$STATE_FILE" 2>/dev/null || echo "unknown"
}

set_gpu_mode() {
  local mode="$1"

  command -v supergfxctl >/dev/null 2>&1 || return 0

  echo "Setting GPU mode -> $mode"
  supergfxctl -m "$mode" >/dev/null 2>&1 || true
}



normal_mode() {
  sudo -v

  echo "Returning to civilization..."

  # General power policy.
  set_profile balanced

  # Normal desktop settings.
  set_refresh_rate "$NORMAL_HZ"
  set_wifi_powersave off
  set_keyboard_backlight 1

  # Make NVIDIA available.
  set_gpu_mode Hybrid

  save_mode normal
  notify "Power mode" "Normal ⚡"
}

monk_mode() {
  sudo -v

  echo "Entering monastery..."

  # Aggressive power policy.
  set_profile power-saver

  # Battery-saving extras.
  set_refresh_rate "$MONK_HZ"
  set_wifi_powersave on
  set_keyboard_backlight 0

  # Kill the dGPU completely.
  set_gpu_mode Integrated

  save_mode monk
  notify "Power mode" "MONK MODE 🧘"
}

next_mode() {
  case "$(current_mode)" in
    monk)
      normal_mode
      ;;
    *)
      monk_mode
      ;;
  esac
}

auto_mode() {
  local online="0"

  for f in /sys/class/power_supply/A{C,DP}*/online; do
    [ -e "$f" ] || continue
    online="$(cat "$f" 2>/dev/null || echo 0)"
    break
  done

  if [ "$online" = "1" ]; then
    normal_mode
  else
    monk_mode
  fi
}

status_mode() {
  local mode
  local profile
  local platform
  local governor
  local epp
  local gfx
  local dgpu
  local display
  local battery_w

  mode="$(current_mode)"
  profile="$(powerprofilesctl get 2>/dev/null || echo unknown)"

  platform="$(
    cat /sys/firmware/acpi/platform_profile \
      2>/dev/null || echo unknown
  )"

  governor="$(
    cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor \
      2>/dev/null || echo unknown
  )"

  epp="$(
    cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference \
      2>/dev/null || echo unknown
  )"

  gfx="$(supergfxctl -g 2>/dev/null || echo unknown)"
  dgpu="$(supergfxctl -S 2>/dev/null || echo unknown)"

  display="$(
    hyprctl monitors 2>/dev/null |
      awk '/^[[:space:]]*[0-9]+x[0-9]+@/ {print $1; exit}' ||
      true
  )"

  if command -v jq >/dev/null 2>&1 &&
     command -v battery >/dev/null 2>&1; then

    battery_w="$(
      battery json 2>/dev/null |
        jq -r '
          if .power_w
          then (.power_w | tostring + "W")
          else "unknown"
          end
        '
    )"
  else
    battery_w="unknown"
  fi

  echo "mode: $mode"
  echo "ppd_profile: $profile"
  echo "platform: $platform"
  echo "governor: $governor"
  echo "epp: $epp"
  echo "gpu: $gfx ($dgpu)"
  echo "display: ${display:-unknown}"
  echo "battery_w: $battery_w"
}

json_status() {
  local mode
  local profile
  local platform
  local governor
  local epp
  local gfx
  local dgpu
  local display
  local battery_w

  mode="$(current_mode)"
  profile="$(powerprofilesctl get 2>/dev/null || echo unknown)"

  platform="$(
    cat /sys/firmware/acpi/platform_profile \
      2>/dev/null || echo unknown
  )"

  governor="$(
    cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor \
      2>/dev/null || echo unknown
  )"

  epp="$(
    cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference \
      2>/dev/null || echo unknown
  )"

  gfx="$(supergfxctl -g 2>/dev/null || echo unknown)"
  dgpu="$(supergfxctl -S 2>/dev/null || echo unknown)"

  display="$(
    hyprctl monitors 2>/dev/null |
      awk '/^[[:space:]]*[0-9]+x[0-9]+@/ {print $1; exit}' ||
      true
  )"

  if command -v jq >/dev/null 2>&1 &&
     command -v battery >/dev/null 2>&1; then
    battery_w="$(
      battery json 2>/dev/null |
        jq -r '.power_w // null'
    )"
  else
    battery_w="null"
  fi

  cat <<EOF
{
  "mode": "$mode",
  "ppd_profile": "$profile",
  "platform": "$platform",
  "governor": "$governor",
  "epp": "$epp",
  "gpu_mode": "$gfx",
  "dgpu_status": "$dgpu",
  "display": "${display:-unknown}",
  "battery_w": $battery_w
}
EOF
}

case "${1:-status}" in
  normal)
    normal_mode
    ;;
  monk | battery)
    monk_mode
    ;;
  next)
    next_mode
    ;;
  auto)
    auto_mode
    ;;
  status)
    status_mode
    ;;
  json | status-json)
    json_status
    ;;
  *)
    echo "usage: power-mode normal|monk|next|auto|status|json"
    exit 1
    ;;
esac
